FROM nginx:latest

LABEL maintainer="avinash"
LABEL description="Static HTML Dashboard with Nginx (Non-root user)"

# Create a non-root user
RUN addgroup --system webgroup \
    && adduser --system --ingroup webgroup webuser

# Copy static files
COPY . /usr/share/nginx/html

# Change ownership so nginx can access files
RUN chown -R webuser:webgroup /usr/share/nginx/html \
    && chown -R webuser:webgroup /var/cache/nginx \
    && chown -R webuser:webgroup /var/run

# Switch to non-root user
USER webuser

EXPOSE 80

ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
