pipeline {
    agent any

    environment {
        DATABASE_REPO="task_manager_db"
        DATABASE_CONTAINER_NAME="mysql_task_manager"
        BACKEND_REPO="task_manager_be"
        BACKEND_CONTAINER_NAME="backend_task_manager"
        FRONTEND_REPO="task_manager_fe"
        FRONTEND_CONTAINER_NAME="frontend_task_manager"
    }

    stages {

        stage("Clean Workspace") {
            steps {
                cleanWs()
            }
        }

        stage("Code") {
            steps {
                git branch: 'images',
                    url: 'https://github.com/avinashdevops0/Devops_Docker_Notes.git'
            }
        }

        stage("Build") {
            steps {
                dir("task-manager-3-tire/database") {
                    sh "docker image build --no-cache -t ${DATABASE_REPO} ."
                }
                dir("task-manager-3-tire/server") {
                    sh "docker image build --no-cache -t ${BACKEND_REPO} ."
                }
                dir("task-manager-3-tire/client") {
                    sh "docker image build --no-cache -t ${FRONTEND_REPO} ."
                }
            }
        }

        stage("Running Containers") {
            steps {
                sh "docker network create task_manager || true"
                sh "docker rm -f ${DATABASE_CONTAINER_NAME} || true"

                sh """
                docker run -d \
                --name ${DATABASE_CONTAINER_NAME} \
                --network task_manager \
                ${DATABASE_REPO}:latest
                """

                sh "sleep 10"

                sh """
                docker exec ${DATABASE_CONTAINER_NAME} \
                mysql -u dev_task_manager -ppassword123 \
                -e "SHOW DATABASES;"  
                """
                // // -e stands for execute. It tells the MySQL client to execute the given SQL statement and exit, instead of opening an interactive MySQL shell
                
            }
        }
        stage("Docker_Hub_Login") {
            steps {
                withDockerRegistry(credentialsId: 'Docker_Hub', url: 'https://index.docker.io/v1/') {
    // some block
}
            }
        }
    }
}
